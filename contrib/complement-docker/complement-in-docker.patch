+// joinNetwork connects the container that Complement runs in to the network, with the alias that homeservers use for
+// Complement, when COMPLEMENT_IN_DOCKER_NETWORK is on. The hostname of a container is its ID.
+func joinNetwork(docker *client.Client, networkName string, cfg *config.Complement) error {
+	if !cfg.InDockerNetwork {
+		return nil
+	}
+	self, err := os.Hostname()
+	if err != nil {
+		return fmt.Errorf("joinNetwork: %w", err)
+	}
+	_, err = docker.NetworkConnect(context.Background(), networkName, client.NetworkConnectOptions{
+		Container:      self,
+		EndpointConfig: &network.EndpointSettings{Aliases: []string{cfg.HostnameRunningComplement}},
+	})
+	if err != nil && !strings.Contains(err.Error(), "already exists") {
+		return fmt.Errorf("joinNetwork: connecting %s to %s: %w", self, networkName, err)
+	}
+	return nil
+}
